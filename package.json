{
  "name": "@cathrin/root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@cathrin/desktop",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "tauri": "pnpm --filter @cathrin/desktop tauri",
