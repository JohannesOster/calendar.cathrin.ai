# Server configuration
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cathrin

# Encryption key for OAuth tokens (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT Session (generate secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
SESSION_DURATION_DAYS=30

# Google Calendar push notifications (optional — falls back to polling without this)
# Requires a publicly accessible HTTPS endpoint. For local dev, use ngrok/cloudflared.
# Example: WEBHOOK_BASE_URL=https://abc123.ngrok.io
WEBHOOK_BASE_URL=
